# Copy to .env in the repo root (never commit .env).
# ASP.NET Core maps nested config with double underscores.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lumify
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lumify

ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=lumify;Username=lumify;Password=change_me

Jwt__Issuer=Lumify
Jwt__Audience=LumifyClients
Jwt__Key=replace-with-at-least-32-character-secret

# Optional. Empty = look for ffmpeg/ffprobe in PATH.
FFmpeg__BinaryFolder=
